# Copy to .env.prod (gitignored) and replace every "change-me".
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Postgres container
POSTGRES_USER=meow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meowdoption

# API (same password as above)
MEOW_DATABASE_URL=postgresql+psycopg://meow:change-me@db:5432/meowdoption
# At least 32 characters; the API refuses to start with the dev default.
MEOW_SECRET_KEY=change-me
