# --- dev: Vite dev server; compose bind-mounts the code ------------------------
FROM docker.io/library/node:24-alpine AS dev

WORKDIR /app

# Deps layer is cached until package*.json changes.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev"]


# --- build: typecheck + production bundle ---------------------------------------
FROM dev AS build
RUN npm run build


# --- prod: static files on nginx (non-root image), proxying /api and /media ----
FROM docker.io/nginxinc/nginx-unprivileged:1.29-alpine AS prod

# --chmod: nginx runs as uid 101, and COPY would keep the source's mode
# (unreadable for "others" on e.g. a VirtualBox share).
COPY --chmod=644 nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --chmod=644 nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
